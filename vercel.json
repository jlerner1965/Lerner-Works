{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/work/hm-mechanical",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/work/hm-mechanical/",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/work/hm-mechanical/:path*",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/concepts/:path*",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/concepts/hm-mechanical/",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/concepts/hm-mechanical/service/",
      "destination": "/work/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self' data:; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()"
        }
      ]
    }
  ]
}
